# Chave da YouTube Data API v3 (Google Cloud Console → Credenciais). Fica só no servidor.
YOUTUBE_API_KEY=

# Connection string do banco Neon (PostgreSQL), ex.: postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=

# Senha única para entrar no ZamparTube.
APP_PASSWORD=

# Segredo longo e aleatório para assinar o cookie de sessão (ex.: openssl rand -hex 32).
SESSION_SECRET=

# Segredo que a Vercel Cron envia para /api/cron/sync (ex.: openssl rand -hex 32).
CRON_SECRET=
